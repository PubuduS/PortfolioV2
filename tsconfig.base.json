{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": false,
    "experimentalDecorators": true,
    "importHelpers": true,
    "types": ["@angular/localize"],
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@portfolio-v2/contracts/contact-limits": ["libs/contracts/contact-limits.ts"],
      "@portfolio-v2/contracts/site-analytics": ["libs/contracts/site-analytics.ts"],
      "@portfolio-v2/data-access/get-data": ["libs/data-access/src/get-data.service.ts"],
      "@portfolio-v2/data-access/get-date-time": ["libs/data-access/src/get-date-time.service.ts"],
      "@portfolio-v2/domain/url-pattern": ["libs/domain/src/url-pattern.ts"],
      "@portfolio-v2/const": ["libs/const/index.ts"],
      "@portfolio-v2/environment": ["libs/environment/src/index.ts"],
      "@portfolio-v2/environment/emulator": ["libs/environment/src/environment.emulator.ts"],
      "@portfolio-v2/environment/model": ["libs/environment/src/environment.model.ts"],
      "@portfolio-v2/portfolio-pages": ["libs/pages/src/index.ts"],
      "@portfolio-v2/portfolio-pages/education-main": [
        "libs/pages/src/lib/components/education-main/education-main.component.ts"
      ],
      "@portfolio-v2/portfolio-pages/landing-banner": [
        "libs/pages/src/lib/components/landing-banner/landing-banner.component.ts"
      ],
      "@portfolio-v2/portfolio-pages/page-not-found": [
        "libs/pages/src/lib/components/page-not-found/page-not-found.component.ts"
      ],
      "@portfolio-v2/portfolio-pages/page-routes": [
        "libs/pages/src/lib/components/page.route.ts"
      ],
      "@portfolio-v2/portfolio-pages/project-tile": [
        "libs/pages/src/lib/components/portfolio/components/project-tile/project-tile.component.ts"
      ],
      "@portfolio-v2/portfolio-pages/project-link-icon": [
        "libs/pages/src/lib/components/portfolio/components/project-link-icon/project-link-icon.component.ts"
      ],
      "@portfolio-v2/shared/components": [
        "libs/shared/src/lib/components/index.ts"
      ],
      "@portfolio-v2/shared/forms": [
        "libs/shared/src/lib/forms/field-has-error.ts"
      ],
      "@portfolio-v2/shared/pipes": ["libs/shared/src/lib/pipes/index.ts"],
      "@portfolio-v2/shared/services": [
        "libs/shared/src/lib/services/index.ts"
      ],
      "@portfolio-v2/shared/validators": [
        "libs/shared/src/lib/validators/index.ts"
      ],
      "@portfolio-v2/shared/validators/url-pattern": [
        "libs/shared/src/lib/validators/url-pattern.ts"
      ],
      "@portfolio-v2/shared/test-helpers": [
        "libs/shared/src/lib/test-helpers/index.ts"
      ],
      "@portfolio-v2/shared/types": ["libs/shared/src/lib/types/index.ts"],
      "@portfolio-v2/state": ["libs/state/src/index.ts"],
      "@portfolio-v2/state/actions": ["libs/state/src/lib/state.actions.ts"],
      "@portfolio-v2/state/dataModels": ["libs/domain/src/index.ts"],
      "@portfolio-v2/state/selectors": [
        "libs/state/src/lib/selectors/index.ts"
      ],
      "@portfolio-v2/admin/shared/components": [
        "libs/admin/shared/components/src/index.ts"
      ],
      "@portfolio-v2/admin/shared/types": [
        "libs/admin/shared/types/src/index.ts"
      ],
      "@portfolio-v2/admin-components": [
        "libs/admin/admin-components/src/index.ts"
      ],
      "@portfolio-v2/tools/db/constants": ["tools/db/constants.ts"],
      "@portfolio-v2/tools/db/guards": ["tools/db/guards.ts"],
      "@portfolio-v2/tools/db/reset": ["tools/db/reset.ts"],
      "@portfolio-v2/tools/coverage/remap": ["tools/coverage/remap.ts"],
      "@portfolio-v2/tools/coverage/workspace-path": ["tools/coverage/workspace-path.ts"]
    },
    "strict": true,
    "noUncheckedSideEffectImports": false,
    "esModuleInterop": false,
    "ignoreDeprecations": "6.0"
  },
  "exclude": ["node_modules", "tmp"]
}
