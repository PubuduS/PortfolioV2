{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2022",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "types": ["node"],
    "outDir": "lib",
    "rootDir": "..",
    "strict": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "noUncheckedSideEffectImports": false,
    "baseUrl": "..",
    "paths": {
      "@portfolio-v2/contracts/contact-limits": ["libs/contracts/contact-limits.ts"]
    }
  },
  "include": ["src", "../libs/contracts"],
  "exclude": ["src/**/*.spec.ts"]
}
