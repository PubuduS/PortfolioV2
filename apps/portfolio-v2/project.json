{
  "name": "portfolio-v2",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "portfolio-v2",
  "sourceRoot": "apps/portfolio-v2/src",
  "tags": ["type:app"],
  "targets": {
    "build": {
      "executor": "@angular-devkit/build-angular:application",
      "outputs": [
        "{options.outputPath.base}"
      ],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": {
          "base": "dist/apps/portfolio-v2",
          "browser": ""
        },
        "index": "apps/portfolio-v2/src/index.html",
        "browser": "apps/portfolio-v2/src/main.ts",
        "polyfills": [],
        "tsConfig": "apps/portfolio-v2/tsconfig.app.json",
        "assets": [
          "apps/portfolio-v2/src/favicon.ico",
          "apps/portfolio-v2/src/assets"
        ],
        "styles": [
          "@angular/material/prebuilt-themes/indigo-pink.css",
          "apps/portfolio-v2/src/assets/SCSS/styles.scss"
        ],
        "stylePreprocessorOptions": {
          "includePaths": ["libs/shared/src/lib/styles", "."]
        }
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "800kb",
              "maximumError": "2.5mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "10kb",
              "maximumError": "20kb"
            }
          ],
          "outputHashing": "all"
        },
        "emulator": {
          "optimization": false,
          "sourceMap": true,
          "fileReplacements": [
            {
              "replace": "libs/environment/src/environment.ts",
              "with": "libs/environment/src/environment.emulator.ts"
            }
          ]
        },
        "live": {
          "optimization": false,
          "sourceMap": true,
          "fileReplacements": [
            {
              "replace": "libs/environment/src/environment.ts",
              "with": "libs/environment/src/environment.development.ts"
            }
          ]
        }
      }
    },
    "serve": {
      "executor": "@angular-devkit/build-angular:dev-server",
      "defaultConfiguration": "emulator",
      "continuous": true,
      "configurations": {
        "production": {
          "buildTarget": "portfolio-v2:build:production"
        },
        "emulator": {
          "buildTarget": "portfolio-v2:build:emulator"
        },
        "live": {
          "buildTarget": "portfolio-v2:build:live"
        }
      }
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "buildTarget": "portfolio-v2:build"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "stylelint": {
      "executor": "nx-stylelint:lint",
      "options": {
        "lintFilePatterns": [
          "apps/portfolio-v2/src/assets/SCSS/styles.scss"
        ]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "jestConfig": "apps/portfolio-v2/jest.config.ts",
        "tsConfig": "apps/portfolio-v2/tsconfig.spec.json"
      }
    },
    "serve-static": {
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "portfolio-v2:build"
      }
    }
  }
}
