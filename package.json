{
  "name": "@portfolio-v2/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "start": "nx serve portfolio-v2 --configuration=emulator -o --watch",
    "start:live": "nx serve portfolio-v2 --configuration=live -o --watch",
    "emulators": "tsx tools/db/emulators.ts",
    "db:snapshot": "tsx tools/db/snapshot.ts",
    "db:seed": "tsx tools/db/seed.ts",
    "db:reset": "tsx tools/db/reset.ts",
    "db:verify": "tsx tools/db/verify.ts",
    "build": "nx build portfolio-v2",
    "clean": "nx reset",
    "test": "nx run-many --target=test --parallel=5 --runInBand",
    "test:coverage": "nx run-many --target=test --configuration=ci --parallel=5 --runInBand",
    "test-ci": "cross-env NODE_ENV=test NODE_OPTIONS=--max-old-space-size=8192 jest --ci --reporters=default --reporters=jest-junit --collectCoverage  --forceExit",
    "coverage:jest": "tsx tools/coverage/merge-coverage.ts jest",
    "coverage:playwright": "tsx tools/coverage/merge-coverage.ts playwright",
    "lint": "nx run-many --target=lint --parallel=5 && nx run-many --target=stylelint --parallel=5",
    "compodoc": "tsx tools/docs/run-compodoc.ts && tsx tools/docs/compodoc-routes.ts && tsx tools/docs/attach-coverage.ts",
    "e2e-tests": "nx run portfolio-v2-e2e:e2e",
    "build-checks": "npm run clean & npm run test & npm run test-ci & npm run lint"
  },
  "private": true,
