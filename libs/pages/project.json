{
  "name": "portfolio-pages",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/pages/src",
  "prefix": "portfolio-v2",
  "projectType": "library",
  "tags": [
    "scope:pages"
  ],
  "targets": {
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "jestConfig": "libs/pages/jest.config.ts",
        "tsConfig": "libs/pages/tsconfig.spec.json"
      },
      "configurations": {
        "ci": {
          "ci": true,
          "codeCoverage": true
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": [
        "{options.outputFile}"
      ],
      "options": {
        "lintFilePatterns": [
          "libs/pages/**/*.ts",
          "libs/pages/**/*.html"
        ]
      }
    },
    "stylelint": {
      "executor": "nx-stylelint:lint",
      "options": {
        "lintFilePatterns": [
          "libs/pages/src/lib/components/experience/**/*.scss",
          "libs/pages/src/lib/components/skills/**/*.scss",
          "libs/pages/src/lib/components/portfolio/portfolio.component.scss",
          "libs/pages/src/lib/components/portfolio/components/featured-projects/**/*.scss",
          "libs/pages/src/lib/components/portfolio/components/project-tile/project-tile.component.scss",
          "libs/pages/src/lib/components/education-main/components/education/education.component.scss",
          "libs/pages/src/lib/components/education-main/components/certifications/certifications.component.scss",
          "libs/pages/src/lib/components/education-main/components/publications/publications.component.scss",
          "libs/pages/src/lib/components/cover-letter/cover-letter.component.scss",
          "libs/pages/src/lib/components/about-me/about-me.component.scss",
          "libs/pages/src/lib/components/contact/contact.component.scss"
        ]
      }
    }
  }
}
