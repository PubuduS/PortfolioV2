{
  "name": "shared",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/shared/src",
  "prefix": "portfolio",
  "projectType": "library",
  "tags": [
    "scope:shared"
  ],
  "targets": {
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "jestConfig": "libs/shared/jest.config.ts",
        "tsConfig": "libs/shared/tsconfig.spec.json"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "stylelint": {
      "executor": "nx-stylelint:lint",
      "options": {
        "lintFilePatterns": [
          "libs/shared/src/lib/styles/_colors.scss",
          "libs/shared/src/lib/styles/_mixins.scss",
          "libs/shared/src/lib/styles/_layout.scss",
          "libs/shared/src/lib/styles/_sections.scss",
          "libs/shared/src/lib/styles/_featured-projects.scss",
          "libs/shared/src/lib/styles/styles.scss"
        ]
      }
    }
  }
}
