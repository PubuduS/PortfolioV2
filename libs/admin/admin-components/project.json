{
  "name": "admin-components",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/admin/admin-components/src",
  "prefix": "admin",
  "projectType": "library",
  "tags": [
    "scope:admin"
  ],
  "targets": {
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "jestConfig": "libs/admin/admin-components/jest.config.cts",
        "tsConfig": "libs/admin/admin-components/tsconfig.spec.json"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "stylelint": {
      "executor": "nx-stylelint:lint",
      "options": {
        "lintFilePatterns": [
          "libs/admin/admin-components/src/lib/experience/experience.component.scss",
          "libs/admin/admin-components/src/lib/skills/skills.component.scss",
          "libs/admin/admin-components/src/lib/portfolio/portfolio.component.scss",
          "libs/admin/admin-components/src/lib/portfolio/components/featured-projects/featured-projects.component.scss"
        ]
      }
    }
  }
}
